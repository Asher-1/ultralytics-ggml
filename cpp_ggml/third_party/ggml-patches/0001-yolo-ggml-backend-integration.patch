+// One-shot Q8_0 -> KRSC half expansion run at plan creation. Source blocks are
+// laid out per output channel in torch's c-major order (k' = c*R*S + rs, rs
+// fastest inside a block); the scatter maps each element to its GEMM-order
+// position k = rs*C + c so the conv kernel's B-tile loads stay sequential.
+// Dequantizing once here — instead of gathering and converting per element
+// inside the hot conv kernel — is what lets quantized convs run at f16 speed.
+static __global__ void igemm_q8_dequant_kernel(
+        const block_q8_0 * __restrict__ src, half * __restrict__ dst,
+        const int C, const int RS, const int nblk, const int K_gemm, const int64_t total) {
+    const int64_t idx = (int64_t) blockIdx.x * blockDim.x + threadIdx.x; // n * nblk + blk
+    if (idx >= total) {
+        return;
+    }
+    const block_q8_0 * s = src + idx;
+    const float d  = __half2float(s->d);
+    const int blk  = idx % nblk;
+    const int n    = idx / nblk;
+    const int k0   = blk * QK8_0;     // k' = c*RS + rs
+    const int c0   = k0 / RS;
+    const int rs0  = k0 % RS;
+    half * row = dst + (int64_t) n * K_gemm;
+    #pragma unroll
+    for (int j = 0; j < QK8_0; ++j) {
+        const int c  = c0 + (rs0 + j) / RS;
+        const int rs = (rs0 + j) % RS;
+        row[rs * C + c] = __float2half(d * s->qs[j]);
+    }
+}
