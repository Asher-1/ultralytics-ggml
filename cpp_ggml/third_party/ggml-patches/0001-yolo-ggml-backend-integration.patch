+    const cudnnDataType_t data_type = input->type == GGML_TYPE_F16 ? CUDNN_DATA_HALF : CUDNN_DATA_FLOAT;
+
+    int64_t x_dim[] = {input->ne[3], input->ne[2], input->ne[1], input->ne[0]};
+    int64_t y_dim[] = {dst->ne[3], dst->ne[2], dst->ne[1], dst->ne[0]};
+    int64_t w_dim[] = {kernel->ne[3], kernel->ne[2], kernel->ne[1], kernel->ne[0]};
+    int64_t x_stride[] = {input->ne[1] * input->ne[0] * input->ne[2], 1, input->ne[0] * input->ne[2], input->ne[2]};
+    int64_t y_stride[] = {dst->ne[1] * dst->ne[0] * dst->ne[2], 1, dst->ne[0] * dst->ne[2], dst->ne[2]};
+    int64_t w_stride[] = {kernel->ne[1] * kernel->ne[0] * kernel->ne[2], 1,
+                          kernel->ne[0] * kernel->ne[2], kernel->ne[2]};
+    int64_t padding[] = {p[3], p[2]};
+    int64_t stride[] = {p[1], p[0]};
+    int64_t dilation[] = {p[5], p[4]};
+    const bool fuse_bias_silu = dst->src[2] && p[7] == 1;
+
+    if (!prepare_nhwc_buffers(cctx, dst, plan, fuse_bias_silu)) return false;
+    cudaStream_t frontend_stream = nullptr;
+    cudnnGetStream(cctx.handle, &frontend_stream);
+
+    try {
+        auto x = cudnn_frontend::TensorBuilder()
+                     .setDim(4, x_dim).setStride(4, x_stride).setId('x').setAlignment(16)
+                     .setDataType(data_type).build();
+        auto w = cudnn_frontend::TensorBuilder()
+                     .setDim(4, w_dim).setStride(4, w_stride).setId('w').setAlignment(16)
+                     .setDataType(data_type).build();
+        auto conv = cudnn_frontend::ConvDescBuilder()
+                        .setComputeType(CUDNN_DATA_FLOAT).setMathMode(CUDNN_CROSS_CORRELATION)
+                        .setSpatialDimCount(2).setSpatialStride(2, stride)
+                        .setPrePadding(2, padding).setPostPadding(2, padding).setDilation(2, dilation).build();
+        auto select_plan = [&](cudnn_frontend::OperationGraph & graph, bool fused) {
+            cudnn_frontend::EngineConfigList configs;
+            cudnn_frontend::get_heuristics_list<2>(
+                {"heuristics_instant", "heuristics_fallback"}, graph,
+                [](cudnnBackendDescriptor_t) { return false; }, configs, true);
+            cudnn_frontend::executionPlans_t candidates;
+            for (auto & config : configs) {
+                try {
+                    auto candidate = cudnn_frontend::ExecutionPlanBuilder()
+                                         .setHandle(cctx.handle).setEngineConfig(config, graph.getTag()).build();
+                    if (candidate.getWorkspaceSize() <= (int64_t)cctx.workspace_bytes) {
+                        candidates.emplace_back(std::move(candidate));
+                        break;
+                    }
+                } catch (cudnn_frontend::cudnnException &) {
+                }
+            }
+            if (candidates.empty()) return false;
+
+            void * data_ptrs[] = {
+                plan.frontend_input, plan.frontend_output, plan.frontend_weight,
+                plan.frontend_bias ? plan.frontend_bias : (dst->src[2] ? dst->src[2]->data : nullptr)};
+            int64_t uids[] = {'x', 'y', 'w', 'b'};
+            const int64_t pointer_count = fused ? 4 : 3;
+            auto variant = cudnn_frontend::VariantPackBuilder()
+                               .setWorkspacePointer(cctx.workspace).setDataPointers(pointer_count, data_ptrs)
+                               .setUids(pointer_count, uids).build();
+            auto timed = cudnn_frontend::time_sorted_plan<
+                cudnn_frontend::CudnnFindSamplingTechnique::CUDNN_FIND_SAMPLE_ONCE>(
+                    cctx.handle, std::move(candidates), variant, 1);
+            if (timed.empty()) return false;
+            plan.frontend_plan = timed.front().get_desc();
+
+            auto execute = [&]() {
+                nchw_to_nhwc(input->data, plan.frontend_input, data_type, input->ne[3], input->ne[2],
+                             input->ne[1], input->ne[0], frontend_stream);
+                const cudnnStatus_t status = cudnnBackendExecute(
+                    cctx.handle, plan.frontend_plan->get_backend_descriptor(), variant.get_raw_desc());
+                if (status == CUDNN_STATUS_SUCCESS) {
+                    nhwc_to_nchw(plan.frontend_output, dst->data, data_type, dst->ne[3], dst->ne[2],
+                                 dst->ne[1], dst->ne[0], frontend_stream);
+                }
+                return status;
+            };
+            if (execute() != CUDNN_STATUS_SUCCESS || cudaStreamSynchronize(frontend_stream) != cudaSuccess) {
+                cudaGetLastError();
+                plan.frontend_plan.reset();
+                return false;
+            }
+            cudaEvent_t start = nullptr;
+            cudaEvent_t stop = nullptr;
+            cudaEventCreate(&start);
+            cudaEventCreate(&stop);
+            std::array<float, 3> times{};
+            for (float & time : times) {
+                cudaEventRecord(start, frontend_stream);
+                if (execute() != CUDNN_STATUS_SUCCESS) {
+                    plan.frontend_plan.reset();
+                    break;
+                }
+                cudaEventRecord(stop, frontend_stream);
+                cudaEventSynchronize(stop);
+                cudaEventElapsedTime(&time, start, stop);
+            }
+            cudaEventDestroy(stop);
+            cudaEventDestroy(start);
+            if (!plan.frontend_plan) return false;
+            std::sort(times.begin(), times.end());
+            plan.frontend_time_ms = times[1];
+            return true;
+        };
+
+        const float alpha = 1.0f;
+        const float beta = 0.0f;
+        auto y = cudnn_frontend::TensorBuilder()
+                     .setDim(4, y_dim).setStride(4, y_stride).setId('y').setAlignment(16)
+                     .setDataType(data_type).build();
+        if (!fuse_bias_silu) {
+            auto operation = cudnn_frontend::OperationBuilder(CUDNN_BACKEND_OPERATION_CONVOLUTION_FORWARD_DESCRIPTOR)
+                                 .setxDesc(x).setyDesc(y).setwDesc(w).setcDesc(conv)
+                                 .setAlpha(alpha).setBeta(beta).build();
+            std::array<cudnn_frontend::Operation const *, 1> operations = {&operation};
+            auto graph = cudnn_frontend::OperationGraphBuilder()
+                             .setHandle(cctx.handle).setOperationGraph(operations.size(), operations.data()).build();
+            return select_plan(graph, false);
+        }
+
+        int64_t b_dim[] = {1, dst->ne[2], 1, 1};
+        int64_t b_stride[] = {dst->ne[2], 1, dst->ne[2], dst->ne[2]};
+        auto b = cudnn_frontend::TensorBuilder()
+                     .setDim(4, b_dim).setStride(4, b_stride).setId('b').setAlignment(16)
+                     .setDataType(data_type).build();
+        auto after_conv = cudnn_frontend::TensorBuilder()
+                              .setDim(4, y_dim).setStride(4, y_stride).setId('c').setAlignment(16)
+                              .setDataType(data_type).setVirtual().build();
+        auto after_bias = cudnn_frontend::TensorBuilder()
+                              .setDim(4, y_dim).setStride(4, y_stride).setId('z').setAlignment(16)
+                              .setDataType(data_type).setVirtual().build();
+        auto add = cudnn_frontend::PointWiseDescBuilder()
+                       .setMode(CUDNN_POINTWISE_ADD).setMathPrecision(CUDNN_DATA_FLOAT).build();
+        auto silu = cudnn_frontend::PointWiseDescBuilder()
+                        .setMode(CUDNN_POINTWISE_SWISH_FWD).setMathPrecision(CUDNN_DATA_FLOAT).build();
+        auto conv_op = cudnn_frontend::OperationBuilder(CUDNN_BACKEND_OPERATION_CONVOLUTION_FORWARD_DESCRIPTOR)
+                           .setxDesc(x).setyDesc(after_conv).setwDesc(w).setcDesc(conv)
+                           .setAlpha(alpha).setBeta(beta).build();
+        auto bias_op = cudnn_frontend::OperationBuilder(CUDNN_BACKEND_OPERATION_POINTWISE_DESCRIPTOR)
+                           .setxDesc(conv_op.getOutputTensor()).setbDesc(b).setyDesc(after_bias).setpwDesc(add)
+                           .setAlpha(alpha).setAlpha2(alpha).build();
+        auto silu_op = cudnn_frontend::OperationBuilder(CUDNN_BACKEND_OPERATION_POINTWISE_DESCRIPTOR)
+                           .setxDesc(bias_op.getOutputTensor()).setyDesc(y).setpwDesc(silu).build();
+        std::array<cudnn_frontend::Operation const *, 3> operations = {&conv_op, &bias_op, &silu_op};
+        auto graph = cudnn_frontend::OperationGraphBuilder()
+                         .setHandle(cctx.handle).setOperationGraph(operations.size(), operations.data()).build();
+        plan.frontend_fused = select_plan(graph, true);
+        return plan.frontend_fused;
+    } catch (cudnn_frontend::cudnnException & error) {
+        GGML_LOG_WARN("cuDNN frontend plan failed: %s\n", error.what());
+    }
+    return false;
+}
+
+static bool cudnn_ok(cudnnStatus_t status, const char * operation) {
+    if (status == CUDNN_STATUS_SUCCESS) return true;
+    GGML_LOG_WARN("cuDNN %s failed: %s\n", operation, cudnnGetErrorString(status));
+    return false;
+}
+
+static float time_legacy_plan(cudnn_conv_context & cctx, ggml_tensor * dst, cudnn_conv_plan & plan,
+                              const cudnnConvolutionFwdAlgoPerf_t & candidate) {
+    const float alpha = 1.0f;
+    const float beta = 0.0f;
+    cudaStream_t stream = nullptr;
+    cudnnGetStream(cctx.handle, &stream);
+    auto execute = [&]() {
+        const cudnnStatus_t status = cudnnConvolutionForward(
+            cctx.handle, &alpha, plan.x_desc, dst->src[1]->data, plan.w_desc, dst->src[0]->data,
+            plan.conv_desc, candidate.algo, cctx.workspace, candidate.memory, &beta, plan.y_desc, dst->data);
+        if (status == CUDNN_STATUS_SUCCESS) bias_silu_cuda(dst, stream);
+        return status;
+    };
+
+    if (execute() != CUDNN_STATUS_SUCCESS || cudaDeviceSynchronize() != cudaSuccess) {
+        cudaGetLastError();
+        return std::numeric_limits<float>::max();
+    }
+
+    cudaEvent_t start = nullptr;
+    cudaEvent_t stop = nullptr;
+    if (cudaEventCreate(&start) != cudaSuccess || cudaEventCreate(&stop) != cudaSuccess) {
+        if (start) cudaEventDestroy(start);
+        if (stop) cudaEventDestroy(stop);
+        cudaGetLastError();
+        return std::numeric_limits<float>::max();
+    }
+
+    std::array<float, 3> times{};
+    bool valid = true;
+    for (float & time : times) {
+        if (cudaEventRecord(start, stream) != cudaSuccess || execute() != CUDNN_STATUS_SUCCESS ||
+            cudaEventRecord(stop, stream) != cudaSuccess || cudaEventSynchronize(stop) != cudaSuccess ||
+            cudaEventElapsedTime(&time, start, stop) != cudaSuccess) {
+            valid = false;
+            break;
+        }
+    }
+    cudaEventDestroy(stop);
+    cudaEventDestroy(start);
+    if (!valid) {
+        cudaGetLastError();
+        return std::numeric_limits<float>::max();
+    }
+    std::sort(times.begin(), times.end());
+    return times[1];
+}
+
+static cudnn_conv_plan * create_cudnn_plan(cudnn_conv_context & cctx, const ggml_tensor * dst, bool depthwise) {
+    const ggml_tensor * kernel = dst->src[0];
+    const ggml_tensor * input = dst->src[1];
+    const cudnnDataType_t data_type = input->type == GGML_TYPE_F16 ? CUDNN_DATA_HALF : CUDNN_DATA_FLOAT;
+    auto plan = std::make_unique<cudnn_conv_plan>();
+
+    if (!cudnn_ok(cudnnCreateTensorDescriptor(&plan->x_desc), "create input descriptor") ||
+        !cudnn_ok(cudnnCreateTensorDescriptor(&plan->y_desc), "create output descriptor") ||
+        !cudnn_ok(cudnnCreateFilterDescriptor(&plan->w_desc), "create filter descriptor") ||
+        !cudnn_ok(cudnnCreateConvolutionDescriptor(&plan->conv_desc), "create convolution descriptor")) {
+        return nullptr;
+    }
+
+    const int32_t * p = (const int32_t *) dst->op_params;
+    if (!cudnn_ok(cudnnSetTensor4dDescriptor(plan->x_desc, CUDNN_TENSOR_NCHW, data_type,
+                                              input->ne[3], input->ne[2], input->ne[1], input->ne[0]),
+                  "set input descriptor") ||
+        !cudnn_ok(cudnnSetTensor4dDescriptor(plan->y_desc, CUDNN_TENSOR_NCHW, data_type,
+                                              dst->ne[3], dst->ne[2], dst->ne[1], dst->ne[0]),
+                  "set output descriptor") ||
+        !cudnn_ok(cudnnSetFilter4dDescriptor(plan->w_desc, data_type, CUDNN_TENSOR_NCHW,
+                                              kernel->ne[3], kernel->ne[2], kernel->ne[1], kernel->ne[0]),
+                  "set filter descriptor") ||
+        !cudnn_ok(cudnnSetConvolution2dDescriptor(plan->conv_desc, p[3], p[2], p[1], p[0], p[5], p[4],
+                                                   CUDNN_CROSS_CORRELATION, CUDNN_DATA_FLOAT),
+                  "set convolution descriptor")) {
+        return nullptr;
+    }
+    if (depthwise && !cudnn_ok(cudnnSetConvolutionGroupCount(plan->conv_desc, input->ne[2]), "set group count")) {
+        return nullptr;
+    }
+    if (!cudnn_ok(cudnnSetConvolutionMathType(plan->conv_desc, CUDNN_TENSOR_OP_MATH_ALLOW_CONVERSION),
+                  "enable tensor operations")) {
+        return nullptr;
+    }
+
+    const cudnn_conv_shape shape = get_conv_shape(dst, depthwise);
+    float legacy_time = std::numeric_limits<float>::max();
+    bool has_frontend_plan = false;
+#ifdef GGML_CUDA_USE_CUTLASS
+    auto create_cutlass_plan = [&]() {
+        if (depthwise || data_type != CUDNN_DATA_HALF || env_enabled("GGML_CUDA_DISABLE_CUTLASS") ||
+            !prepare_nhwc_buffers(cctx, dst, *plan, false)) {
+            return false;
+        }
+        plan->cutlass_plan = ggml_cuda_cutlass_conv_create(
+            plan->frontend_input, plan->frontend_weight, plan->frontend_output,
+            input->ne[3], input->ne[1], input->ne[0], input->ne[2],
+            dst->ne[1], dst->ne[0], dst->ne[2], kernel->ne[1], kernel->ne[0],
+            p[3], p[2], p[1], p[0], p[5], p[4]);
+        return plan->cutlass_plan != nullptr;
+    };
+#endif
+
+    auto cached = cctx.choices.find(shape);
+    if (cached != cctx.choices.end()) {
+        const cudnn_conv_choice & choice = cached->second;
+        plan->frontend_time_ms = choice.frontend_time_ms;
+        plan->cutlass_time_ms = choice.cutlass_time_ms;
+        legacy_time = choice.legacy_time_ms;
+        plan->algorithms = choice.algorithms;
+        plan->algorithm_count = choice.algorithm_count;
+        plan->algorithm_index = choice.algorithm_index;
+
+        bool restored = false;
+        if (choice.backend == cudnn_conv_backend::frontend && choice.frontend_plan &&
+            prepare_nhwc_buffers(cctx, dst, *plan, choice.frontend_fused)) {
+            plan->frontend_plan = choice.frontend_plan;
+            plan->frontend_fused = choice.frontend_fused;
+            has_frontend_plan = true;
+            restored = true;
+        }
+#ifdef GGML_CUDA_USE_CUTLASS
+        if (choice.backend == cudnn_conv_backend::cutlass) restored = create_cutlass_plan();
+#endif
+        if (choice.backend == cudnn_conv_backend::legacy) {
+            restored = plan->algorithm_index < plan->algorithm_count;
+        }
+
+        if (restored) {
+            if (env_enabled("GGML_CUDA_LOG_CUDNN_PLANS")) {
+                const char * selected = choice.backend == cudnn_conv_backend::frontend ? "frontend" :
+                                       choice.backend == cudnn_conv_backend::cutlass ? "cutlass" : "legacy";
+                GGML_LOG_INFO("CUDA reused %s plan for %" PRId64 "x%" PRId64 "x%" PRId64
+                              " -> %" PRId64 "x%" PRId64 "x%" PRId64 "\n",
+                              selected, input->ne[0], input->ne[1], input->ne[2],
+                              dst->ne[0], dst->ne[1], dst->ne[2]);
+            }
+            cudnn_conv_plan * result = plan.get();
+            cctx.plans.emplace(dst, std::move(plan));
+            return result;
+        }
+        cctx.choices.erase(cached);
+    }
+
+    has_frontend_plan = !env_enabled("GGML_CUDA_DISABLE_CUDNN_FRONTEND") &&
+                        create_frontend_plan(cctx, dst, *plan);
+#ifdef GGML_CUDA_USE_CUTLASS
+    if (create_cutlass_plan()) {
+        cudaStream_t stream = nullptr;
+        cudnnGetStream(cctx.handle, &stream);
+        plan->cutlass_time_ms = time_cutlass_plan(const_cast<ggml_tensor *>(dst), *plan, stream);
+        if (plan->cutlass_time_ms == std::numeric_limits<float>::max()) {
+            ggml_cuda_cutlass_conv_destroy(plan->cutlass_plan);
+            plan->cutlass_plan = nullptr;
+        }
+    }
+#endif
+
+    int count = 0;
+    cudnnConvolutionFwdAlgoPerf_t perf[CUDNN_CONVOLUTION_FWD_ALGO_COUNT];
+    if (!cudnn_ok(cudnnGetConvolutionForwardAlgorithm_v7(
+                      cctx.handle, plan->x_desc, plan->w_desc, plan->conv_desc, plan->y_desc,
+                      CUDNN_CONVOLUTION_FWD_ALGO_COUNT, &count, perf),
+                  "query convolution algorithms") && !has_frontend_plan
+#ifdef GGML_CUDA_USE_CUTLASS
+                  && !plan->cutlass_plan
+#endif
+                  ) {
+        return nullptr;
+    }
+    for (int i = 0; i < count; ++i) {
+        if (perf[i].status == CUDNN_STATUS_SUCCESS && perf[i].memory <= cctx.workspace_bytes) {
+            plan->algorithms[plan->algorithm_count++] = perf[i];
+        }
+    }
+    if (plan->algorithm_count > 0) {
+        legacy_time = time_legacy_plan(cctx, const_cast<ggml_tensor *>(dst), *plan, plan->algorithms[0]);
+        if (legacy_time == std::numeric_limits<float>::max()) {
+            plan->algorithm_index = 1;
+        } else {
+            plan->algorithms[0].time = legacy_time;
+        }
+    }
+    if (has_frontend_plan && std::min(legacy_time, plan->cutlass_time_ms) < plan->frontend_time_ms) {
+        plan->frontend_plan.reset();
+    }
+#ifdef GGML_CUDA_USE_CUTLASS
+    if (plan->cutlass_plan && std::min(legacy_time, plan->frontend_time_ms) < plan->cutlass_time_ms) {
+        ggml_cuda_cutlass_conv_destroy(plan->cutlass_plan);
+        plan->cutlass_plan = nullptr;
+    }
+    if (plan->cutlass_plan) plan->frontend_plan.reset();
+#endif
+    if (!plan->frontend_plan &&
+#ifdef GGML_CUDA_USE_CUTLASS
+        !plan->cutlass_plan &&
+#endif
+        plan->algorithm_count == 0) return nullptr;
+
+    bool uses_nhwc = plan->frontend_plan != nullptr;
+#ifdef GGML_CUDA_USE_CUTLASS
+    uses_nhwc = uses_nhwc || plan->cutlass_plan != nullptr;
+#endif
+    if (!uses_nhwc) {
+        cudaFree(plan->frontend_bias);
+        cudaFree(plan->frontend_weight);
+        cudaFree(plan->frontend_output);
+        cudaFree(plan->frontend_input);
+        plan->frontend_bias = nullptr;
+        plan->frontend_weight = nullptr;
+        plan->frontend_output = nullptr;
+        plan->frontend_input = nullptr;
+    }
+
+    cudnn_conv_choice choice;
+    choice.backend = plan->frontend_plan ? cudnn_conv_backend::frontend :
+#ifdef GGML_CUDA_USE_CUTLASS
+                     plan->cutlass_plan ? cudnn_conv_backend::cutlass :
+#endif
+                     cudnn_conv_backend::legacy;
+    choice.frontend_plan = plan->frontend_plan;
+    choice.frontend_fused = plan->frontend_fused;
+    choice.frontend_time_ms = plan->frontend_time_ms;
+    choice.cutlass_time_ms = plan->cutlass_time_ms;
+    choice.legacy_time_ms = legacy_time;
+    choice.algorithms = plan->algorithms;
+    choice.algorithm_count = plan->algorithm_count;
+    choice.algorithm_index = plan->algorithm_index;
+    cctx.choices.emplace(shape, std::move(choice));
+
+    if (env_enabled("GGML_CUDA_LOG_CUDNN_PLANS")) {
+        const char * selected = plan->frontend_plan ? "frontend" :
+#ifdef GGML_CUDA_USE_CUTLASS
+                                plan->cutlass_plan ? "cutlass" :
+#endif
+                                "legacy";
+        GGML_LOG_INFO("CUDA selected %s plan (frontend %.4f ms, CUTLASS %.4f ms, legacy %.4f ms) for %" PRId64 "x%" PRId64
+                      "x%" PRId64 " -> %" PRId64 "x%" PRId64 "x%" PRId64 "\n",
+                      selected, plan->frontend_time_ms, plan->cutlass_time_ms, legacy_time,
+                      input->ne[0], input->ne[1], input->ne[2], dst->ne[0], dst->ne[1], dst->ne[2]);
+    }
+
+    cudnn_conv_plan * result = plan.get();
+    cctx.plans.emplace(dst, std::move(plan));
+    return result;
+}
+
+static bool conv2d_cudnn(ggml_backend_cuda_context & ctx, ggml_tensor * dst, bool depthwise) {
+    const bool f32 = dst->src[0]->type == GGML_TYPE_F32 && dst->src[1]->type == GGML_TYPE_F32 &&
+                     dst->type == GGML_TYPE_F32;
+    const bool f16 = dst->src[0]->type == GGML_TYPE_F16 && dst->src[1]->type == GGML_TYPE_F16 &&
+                     dst->type == GGML_TYPE_F16;
+    if (!f32 && !f16) {
+        return false;
+    }
+    if (!ctx.cudnn_context) {
+        ctx.cudnn_context = new cudnn_conv_context(ctx.device);
+    }
+    auto & cctx = *(cudnn_conv_context *) ctx.cudnn_context;
+    if (!cctx.handle) return false;
+    if (!cudnn_ok(cudnnSetStream(cctx.handle, ctx.stream()), "set stream")) return false;
+
+    auto it = cctx.plans.find(dst);
+    cudnn_conv_plan * plan = it == cctx.plans.end() ? create_cudnn_plan(cctx, dst, depthwise) : it->second.get();
+    if (!plan) return false;
+    if (plan->disabled) return false;
+
+    const float alpha = 1.0f;
+    const float beta = 0.0f;
+#ifdef GGML_CUDA_USE_CUTLASS
+    if (plan->cutlass_plan) {
+        if (run_cutlass_plan(dst, *plan, ctx.stream())) return true;
+        ggml_cuda_cutlass_conv_destroy(plan->cutlass_plan);
+        plan->cutlass_plan = nullptr;
+    }
+#endif
+    if (plan->frontend_plan) {
+        const cudnnDataType_t data_type = dst->type == GGML_TYPE_F16 ? CUDNN_DATA_HALF : CUDNN_DATA_FLOAT;
+        nchw_to_nhwc(dst->src[1]->data, plan->frontend_input, data_type,
+                     dst->src[1]->ne[3], dst->src[1]->ne[2], dst->src[1]->ne[1], dst->src[1]->ne[0], ctx.stream());
+        void * data_ptrs[] = {plan->frontend_input, plan->frontend_output, plan->frontend_weight,
+                              plan->frontend_bias ? plan->frontend_bias : (dst->src[2] ? dst->src[2]->data : nullptr)};
+        int64_t uids[] = {'x', 'y', 'w', 'b'};
+        const int64_t pointer_count = plan->frontend_fused ? 4 : 3;
+        try {
+            auto variant = cudnn_frontend::VariantPackBuilder()
+                               .setWorkspacePointer(cctx.workspace).setDataPointers(pointer_count, data_ptrs)
+                               .setUids(pointer_count, uids).build();
+            if (cudnnBackendExecute(cctx.handle, plan->frontend_plan->get_backend_descriptor(),
+                                    variant.get_raw_desc()) == CUDNN_STATUS_SUCCESS) {
