+// ---------------------------------------------------------------------------
+// k2s2 transposed conv as an igemm 1x1 GEMM (seg Proto / depth-head upsample).
+//
+// out(2i+dy, 2j+dx, co) = sum_ci in(i, j, ci) * w(ci, co, dy, dx) owns exactly
+// one contributing tap per output, so folding the tap index into the GEMM-N
+// dimension (K' = 4*cout) turns the whole layer into a single 1x1 conv over
+// the input grid:
+//     gemm[m, t*cout + co] = sum_ci in[m, ci] * W'[t*cout + co, ci]
+// followed by a vectorized interleave that scatters each 8-wide channel group
+// into the stride-2 output grid. The scalar kernel this replaces re-reads the
+// full K-deep weight column per thread from L2 (~3.4 GB of replay traffic on a
+// 256ch layer, measured 4.7 ms on RTX 3060); the WMMA GEMM runs the same math
+// in ~0.4 ms. The input side rides the g_nhwc_copies chain: the upstream conv
+// already published an NHWC copy, so the transpose is free for conv inputs.
+// ---------------------------------------------------------------------------
+
+// ggml conv_transpose weight [KW, KH, Cout, Cin]: w[(ci*cout + co)*4 + t]
+// with t = dy*2 + dx, repacked into the 1x1 KRSC layout [K' = t*cout + co, C].
+static __global__ void ct_k2s2_repack_krsc_kernel(
+        const half * __restrict__ w, half * __restrict__ krsc, int cin, int cout) {
+    const int idx = blockIdx.x * blockDim.x + threadIdx.x; // (ci, co, t)
+    if (idx >= 4 * cin * cout) return;
+    const int t  = idx % 4;
+    const int co = (idx / 4) % cout;
+    const int ci = idx / (4 * cout);
+    krsc[(int64_t) (t * cout + co) * cin + ci] = w[(int64_t) (ci * cout + co) * 4 + t];
+}
+
+// gemm [B, H, W, K'=4*cout] NHWC  ->  out [B, cout, 2H, 2W] CHW. Each thread
+// owns one (8 out_x) x (8 co) block: 8 aligned 16B gathers from the tap-
+// interleaved channel rows, 8 aligned 16B stores along each output row.
+static __global__ void ct_k2s2_interleave_kernel(
+        const half * __restrict__ gemm, half * __restrict__ out,
+        int in_w, int in_h, int cout, int out_w, int out_h, int batches) {
+    const int K4 = 4 * cout;
+    const int nx8 = out_w / 8;
+    const int one = nx8 * out_h * (cout / 8);
+    const int idx = blockIdx.x * blockDim.x + threadIdx.x;
+    if (idx >= one * batches) return;
+    const int b   = idx / one;
+    const int idx0 = idx % one;
+    const int co8 = idx0 / (nx8 * out_h);
+    const int r   = idx0 % (nx8 * out_h);
+    const int y   = r / nx8;
+    const int x0  = (r % nx8) * 8;
+    const int iy  = y >> 1, dy = y & 1;
+    const half * g = gemm + ((int64_t) b * in_h + iy) * in_w * K4 + co8 * 8;
+    half * o = out + (int64_t) b * cout * out_h * out_w + (int64_t) y * out_w + x0;
+
+    alignas(16) half vals[8][8];
+    #pragma unroll
+    for (int i = 0; i < 8; ++i) { // 8 out_x; taps alternate with the low bit
+        const int x = x0 + i;
+        const int t = dy * 2 + (x & 1);
+        * (uint4 *) vals[i] = * (const uint4 *) (g + (int64_t) (x >> 1) * K4 + t * cout);
+    }
+    #pragma unroll
+    for (int c = 0; c < 8; ++c) { // one 16B run per output channel plane
+        alignas(16) half row[8];
+        #pragma unroll
+        for (int i = 0; i < 8; ++i) row[i] = vals[i][c];
+        * (uint4 *) (o + (int64_t) (co8 * 8 + c) * out_h * out_w) = * (const uint4 *) row;
+    }
+}
+
+struct ct_k2s2_gemm_plan {
+    void * krsc     = nullptr; // [4*cout, 1, 1, cin] half, staged once
+    void * nhwc_in  = nullptr; // [B, H, W, cin] half (skipped when chained)
+    void * gemm_out = nullptr; // [B, H, W, 4*cout] half — same numel as dst
+    ~ct_k2s2_gemm_plan() {
+        if (krsc)     cudaFree(krsc);
