+    const dim3 blocks((channels + 31) / 32, (spatial + 31) / 32, batches);
+    const dim3 threads(32, 8);
+    igemm_transpose_batched_kernel<<<blocks, threads, 0, stream>>>(
+        (const T *) src, (T *) dst, spatial, channels);
+}
