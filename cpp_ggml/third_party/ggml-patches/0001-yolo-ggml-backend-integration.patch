+// ---------------------------------------------------------------------------
+// Native implicit-GEMM convolution (WMMA tensor cores, zero dependencies).
+//
+//   out[b,p,q,k] = act( sum_{r,s,c} in[b, ih, iw, c] * w[k,r,s,c] + bias[k] )
+//
+// The convolution is mapped to a blocked GEMM: M = P*Q output positions,
+// N = K output channels, GEMM-K = R*S*C input elements per output (c
+// enumerated fastest). The im2col operand is never materialized in global
+// memory: the A tile [M, K] is formed on the fly in shared memory while
+// loading from the NHWC input — the same trick as CUTLASS implicit GEMM
+// iterators — using only the WMMA API shipped with the CUDA toolkit. Bias
+// and SiLU are fused into the epilogue, so a whole fused conv is a single
+// kernel launch between the NCHW<->NHWC layout transposes.
+// ---------------------------------------------------------------------------
+namespace {
+
+template <typename T>
+static __global__ void igemm_transpose_batched_kernel(
+        const T * src, T * dst, int64_t rows, int64_t columns) {
+    __shared__ T tile[32][33];
+    const int64_t batch = blockIdx.z;
+    const int64_t src_x = blockIdx.x * 32 + threadIdx.x;
+    const int64_t src_y = blockIdx.y * 32 + threadIdx.y;
+    const T * src_batch = src + batch * rows * columns;
+    T * dst_batch = dst + batch * rows * columns;
+    for (int offset = 0; offset < 32; offset += 8) {
+        if (src_x < columns && src_y + offset < rows) {
+            tile[threadIdx.y + offset][threadIdx.x] = src_batch[(src_y + offset) * columns + src_x];
+        }
+    }
+    __syncthreads();
+    const int64_t dst_x = blockIdx.y * 32 + threadIdx.x;
+    const int64_t dst_y = blockIdx.x * 32 + threadIdx.y;
+    for (int offset = 0; offset < 32; offset += 8) {
+        if (dst_x < rows && dst_y + offset < columns) {
+            dst_batch[(dst_y + offset) * rows + dst_x] = tile[threadIdx.x][threadIdx.y + offset];
+        }
+    }
+}
+
+template <typename T>
+static void igemm_nchw_to_nhwc(const void * src, void * dst,
+                               int64_t batches, int64_t channels, int64_t height, int64_t width,
+                               cudaStream_t stream) {
+    const int64_t spatial = height * width;
+    const dim3 blocks((spatial + 31) / 32, (channels + 31) / 32, batches);
+    const dim3 threads(32, 8);
+    igemm_transpose_batched_kernel<<<blocks, threads, 0, stream>>>(
+        (const T *) src, (T *) dst, channels, spatial);
+}
+
+template <typename T>
+static void igemm_nhwc_to_nchw(const void * src, void * dst,
+                               int64_t batches, int64_t channels, int64_t height, int64_t width,
