diff --git a/src/ggml-cuda/cutlass-conv2d.cu b/src/ggml-cuda/cutlass-conv2d.cu
new file mode 100644
index 0000000000000000000000000000000000000000..bda22dc0cb181d1ad31c8f95c9f8e5f6ab4525d6
--- /dev/null
+++ b/src/ggml-cuda/cutlass-conv2d.cu
@@ -0,0 +1,103 @@
+#include "cutlass-conv2d.cuh"
+
+#ifdef GGML_CUDA_USE_CUTLASS
+
+#include "cutlass/conv/kernel/default_conv2d_fprop.h"
+#include "cutlass/conv/device/implicit_gemm_convolution.h"
+
+#include <new>
+
+namespace {
+
+using ElementAccumulator = float;
+using ElementCompute = float;
+using ElementInput = cutlass::half_t;
+using ElementOutput = cutlass::half_t;
+using Layout = cutlass::layout::TensorNHWC;
+using Epilogue = cutlass::epilogue::thread::LinearCombination<
+    ElementOutput, 8, ElementAccumulator, ElementCompute>;
+using Kernel = typename cutlass::conv::kernel::DefaultConv2dFprop<
+    ElementInput, Layout,
+    ElementInput, Layout,
+    ElementOutput, Layout,
+    ElementAccumulator,
+    cutlass::arch::OpClassTensorOp,
+    cutlass::arch::Sm80,
+    cutlass::gemm::GemmShape<128, 128, 64>,
+    cutlass::gemm::GemmShape<64, 64, 64>,
+    cutlass::gemm::GemmShape<16, 8, 16>,
+    Epilogue,
+    cutlass::gemm::threadblock::GemmIdentityThreadblockSwizzle<>,
+    3,
+    cutlass::arch::OpMultiplyAdd,
+    cutlass::conv::IteratorAlgorithm::kOptimized,
+    cutlass::conv::StrideSupport::kUnity>::Kernel;
+using ImplicitGemm = cutlass::conv::device::ImplicitGemmConvolution<Kernel>;
+
+} // namespace
+
+struct ggml_cuda_cutlass_conv {
+    ImplicitGemm op;
+    void * workspace = nullptr;
+
+    ~ggml_cuda_cutlass_conv() {
+        if (workspace) cudaFree(workspace);
+    }
+};
+
+ggml_cuda_cutlass_conv * ggml_cuda_cutlass_conv_create(
+        void * input, void * weight, void * output,
+        int64_t batches, int64_t input_height, int64_t input_width, int64_t input_channels,
+        int64_t output_height, int64_t output_width, int64_t output_channels,
+        int64_t kernel_height, int64_t kernel_width,
+        int64_t pad_height, int64_t pad_width,
+        int64_t stride_height, int64_t stride_width,
+        int64_t dilation_height, int64_t dilation_width) {
+    if (input_channels % 8 != 0 || output_channels % 8 != 0) return nullptr;
+
+    const cutlass::Tensor4DCoord input_size(batches, input_height, input_width, input_channels);
+    const cutlass::Tensor4DCoord filter_size(output_channels, kernel_height, kernel_width, input_channels);
+    const cutlass::Tensor4DCoord padding(pad_height, pad_height, pad_width, pad_width);
+    const cutlass::Tensor4DCoord output_size(batches, output_height, output_width, output_channels);
+    const cutlass::conv::Conv2dProblemSize problem(
+        input_size, filter_size, padding,
+        cutlass::MatrixCoord(stride_height, stride_width),
+        cutlass::MatrixCoord(dilation_height, dilation_width), output_size,
+        cutlass::conv::Mode::kCrossCorrelation, 1);
+
+    cutlass::TensorRef<ElementInput, Layout> input_ref(
+        static_cast<ElementInput *>(input), Layout::packed(input_size));
+    cutlass::TensorRef<ElementInput, Layout> weight_ref(
+        static_cast<ElementInput *>(weight), Layout::packed(filter_size));
+    cutlass::TensorRef<ElementOutput, Layout> output_ref(
+        static_cast<ElementOutput *>(output), Layout::packed(output_size));
+    typename ImplicitGemm::Arguments arguments{
+        problem, input_ref, weight_ref, output_ref, output_ref, {1.0f, 0.0f}};
+
+    auto * plan = new (std::nothrow) ggml_cuda_cutlass_conv;
+    if (!plan || plan->op.can_implement(arguments) != cutlass::Status::kSuccess) {
+        delete plan;
+        return nullptr;
+    }
+    const size_t workspace_bytes = plan->op.get_workspace_size(arguments);
+    if (workspace_bytes > 0 && cudaMalloc(&plan->workspace, workspace_bytes) != cudaSuccess) {
+        cudaGetLastError();
+        delete plan;
+        return nullptr;
+    }
+    if (plan->op.initialize(arguments, plan->workspace) != cutlass::Status::kSuccess) {
+        delete plan;
+        return nullptr;
+    }
+    return plan;
+}
+
+bool ggml_cuda_cutlass_conv_run(ggml_cuda_cutlass_conv * plan, cudaStream_t stream) {
+    return plan && plan->op(stream) == cutlass::Status::kSuccess;
+}
+
+void ggml_cuda_cutlass_conv_destroy(ggml_cuda_cutlass_conv * plan) {
+    delete plan;
+}
+
+#endif
