# Build directories
build*/
bin/
lib/

# Converted models (tracked layout is described in models/MODEL_CARD.md)
models/pytorch/*.pt
models/gguf/*.gguf
models/onnx/*.onnx
*.npz

# Benchmark artifacts
benchmarks/*.json.tmp

# Regression-gate runtime artifacts (baselines re-record via REGRESS_REFRESH=1,
# speed entries append per run; both are local caches, not source)
benchmarks/parity_baseline/
benchmarks/regress/

# Patch-apply flock sentinel (runtime artifact, not source)
third_party/.ggml-patch.lock

# Python + parity-render intermediates
__pycache__/
benchmarks/_*
